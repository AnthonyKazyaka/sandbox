{
  "name": "sandbox",
  "private": true,
  "description": "Test harness for the sandbox projects (the apps themselves stay dependency-free)",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\""
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "three": "0.128.0"
  }
}
